<!DOCTYPE html>
<html>
<head>
    <title><%= title %></title>
    <link rel='stylesheet' href='/stylesheets/style.css' />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
</head>
<body>
    <nav class="navbar navbar-expand-lg bg-body-tertiary">
        <div class="container-fluid">
            <a class="navbar-brand" href="/">Telegram Gifts</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link" href="/">Главная</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/gift">Все подарки</a>
                    </li>
                    
                    <!-- ============ ДИНАМИЧЕСКОЕ МЕНЮ ============ -->
                    <% if(typeof nav == 'object' && nav && nav.length > 0) { 
                        nav.forEach(function(item) { %>
                            <li class="nav-item">
                                <a class="nav-link" href="/gifts/<%= item.nick %>"><%= item.title %></a>
                            </li>
                        <% });
                    } %>
                    <!-- ========================================= -->
                    
                </ul>
                
                <!-- ============ ПРАВАЯ ЧАСТЬ НАВИГАЦИИ (10.7) ============ -->
                <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                    <% if(user) { %>
                        <!-- ДЛЯ ЗАЛОГИНЕННОГО пользователя: Выйти -->
                        <li class="nav-item">
                            <form action="/logout" method="post" class="d-inline">
                                <button type="submit" class="nav-link btn btn-link" 
                                        style="border: none; background: none; cursor: pointer;">
                                    Выйти (<%= user.username %>)
                                </button>
                            </form>
                        </li>
                    <% } else { %>
                        <!-- ДЛЯ НЕЗАЛОГИНЕННОГО пользователя: Войти (СТАРАЯ КНОПКА) -->
                        <li class="nav-item">
                            <a class="nav-link" href="/logreg">Войти</a>
                        </li>
                    <% } %>
                </ul>
                <!-- ======================================================== -->
                
            </div>
        </div>
    </nav>
    
    <%- body %>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
</body>
</html>