<!DOCTYPE html>
<html>
<head>
    <title><%= model.name %> | Telegram Gifts</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        
        .container-main {
            background-color: rgba(255, 255, 255, 0.95);
            border-radius: 20px;
            padding: 40px;
            margin-top: 30px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
        }
        
        .model-header {
            text-align: center;
            margin-bottom: 40px;
        }
        
        .back-link {
            display: inline-block;
            margin-bottom: 20px;
            color: #666;
            text-decoration: none;
            font-weight: 500;
        }
        
        .back-link:hover {
            color: #0088cc;
            text-decoration: underline;
        }
        
        .model-title {
            font-size: 3rem;
            font-weight: 800;
            color: #333;
            margin-bottom: 20px;
        }
        
        .info-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
            margin-bottom: 40px;
        }
        
        .info-item {
            background: #f8f9fa;
            border-radius: 10px;
            padding: 20px;
        }
        
        .info-label {
            color: #666;
            font-weight: 500;
            display: block;
            margin-bottom: 5px;
        }
        
        .info-value {
            color: #222;
            font-weight: 600;
            font-size: 1.2rem;
        }
        
        .telegram-link-box {
            text-align: center;
            padding: 30px;
            background: #f8f9fa;
            border-radius: 15px;
            border: 2px dashed #dee2e6;
        }
        
        .telegram-link {
            display: inline-block;
            background: #0088cc;
            color: white;
            text-decoration: none;
            padding: 12px 30px;
            border-radius: 8px;
            font-weight: 600;
            font-size: 1.1rem;
            margin-top: 15px;
        }
        
        .telegram-link:hover {
            background: #0077b5;
            color: white;
            text-decoration: none;
        }
        
        .link-url {
            display: block;
            font-family: monospace;
            background: white;
            padding: 10px;
            border-radius: 5px;
            margin-top: 10px;
            word-break: break-all;
            font-size: 0.9rem;
            border: 1px solid #dee2e6;
        }
        
        @media (max-width: 768px) {
            .container-main {
                padding: 25px;
            }
            .model-title {
                font-size: 2.2rem;
            }
            .info-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <!-- Навигация -->
    <nav class="navbar navbar-expand-lg navbar-light bg-light mb-4">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold" href="/">🎁 Telegram Gifts</a>
            <div class="collapse navbar-collapse">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" href="/">Главная</a></li>
                    <li class="nav-item"><a class="nav-link" href="/gifts">Коллекции</a></li>
                    <% if(nav && nav.length > 0) { 
                        nav.forEach(function(item) { %>
                            <li class="nav-item">
                                <a class="nav-link" href="/gifts/<%= item.nick %>"><%= item.title %></a>
                            </li>
                        <% });
                    } %>
                </ul>
                <% if(user) { %>
                    <span class="navbar-text me-3"><%= user.username %></span>
                    <form action="/logout" method="post" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-secondary">Выйти</button>
                    </form>
                <% } else { %>
                    <a class="btn btn-sm btn-primary" href="/logreg">Войти</a>
                <% } %>
            </div>
        </div>
    </nav>
    
    <!-- Основной контент -->
    <div class="container container-main">
        <!-- Кнопка назад -->
        <a href="/gifts/<%= collection.nick %>" class="back-link">
            ← Назад к списку моделей
        </a>
        
        <!-- Заголовок -->
        <h1 class="model-title text-center"><%= model.name %></h1>
        <% if (model.image) { %>
<div class="text-center mb-4">
    <img src="<%= model.image %>" 
         alt="<%= model.name %>" 
         class="img-fluid rounded shadow"
         style="max-height: 300px; max-width: 100%;">
</div>
<% } %>
        <!-- Информация о модели -->
        <div class="info-grid">
            <div class="info-item">
                <span class="info-label">Редкость</span>
                
                <span class="info-value"><%= model.rarity %></span>
            </div>
            
            <div class="info-item">
                <span class="info-label">Количество существующих</span>
                <span class="info-value"><%= model.stock %> шт.</span>
            </div>
            
            <div class="info-item">
                <span class="info-label">ID модели</span>
                <span class="info-value"><%= model.id %></span>
            </div>
            
            <div class="info-item">
                <span class="info-label">Коллекция</span>
                <span class="info-value"><%= collection.title %></span>
            </div>
        </div>
        
        <!-- Ссылка на NFT в Telegram -->
        <div class="telegram-link-box">
            <h5>Ссылка на NFT в Telegram:</h5>
            <% if (model.telegramLink) { %>
                <a href="<%= model.telegramLink %>" target="_blank" class="telegram-link">
                    Перейти к NFT в Telegram
                </a>
                <div class="link-url">
                    <%= model.telegramLink %>
                </div>
            <% } else { %>
                <p class="text-muted">Ссылка не указана</p>
            <% } %>
        </div>
    </div>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>