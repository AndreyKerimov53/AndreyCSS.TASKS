<% layout('./layout/page.ejs') %>

<% if(user) { %>
    <h1>Привет, <%= user.username %>! 👋</h1>
    <p class="text-success">Вы успешно вошли в систему.</p>
<% } else { %>
    <h1>Привет, незалогиненный пользователь</h1>
    <p class="text-warning">Рекомендуем <a href="/logreg">войти</a> для просмотра всех возможностей сайта.</p>
<% } %>

<h1><%= title %></h1>
<p>Добро пожаловать в дом уникальных подарков!</p>

<p>Счётчик посещений: <strong><%= counter %></strong></p>