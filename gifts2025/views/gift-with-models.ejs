<!DOCTYPE html>
<html>
<head>
    <title><%= collection.title %> | Telegram Gifts</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        
        .container-main {
            background-color: rgba(255, 255, 255, 0.95);
            border-radius: 20px;
            padding: 30px;
            margin-top: 20px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
        }
        
        .page-header {
            text-align: center;
            margin-bottom: 30px;
            padding-bottom: 15px;
            border-bottom: 1px solid rgba(0, 0, 0, 0.1);
        }
        
        .models-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
        }
        
        .model-item {
            background: white;
            border-radius: 10px;
            padding: 20px;
            box-shadow: 0 3px 10px rgba(0, 0, 0, 0.08);
            transition: all 0.3s ease;
            text-decoration: none;
            color: inherit;
            display: block;
        }
        
        .model-item:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
            text-decoration: none;
            color: inherit;
        }
        
        .model-name {
            font-size: 1.2rem;
            font-weight: 600;
            color: #333;
            margin-bottom: 10px;
        }
        
        .model-info {
            display: flex;
            justify-content: space-between;
            margin-bottom: 5px;
            font-size: 0.95rem;
        }
        
        .info-label {
            color: #666;
        }
        
        .info-value {
            color: #222;
            font-weight: 500;
        }
        
        @media (max-width: 768px) {
            .models-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <!-- Навигация -->
    <!-- Навигация (копируем из вашего page.ejs) -->
<nav class="navbar navbar-expand-lg bg-body-tertiary">
    <div class="container-fluid">
        <a class="navbar-brand" href="/">Telegram Gifts</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarSupportedContent">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <li class="nav-item">
                    <a class="nav-link" href="/">Главная</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/gift">Все подарки</a>
                </li>
                
                <!-- ============ ДИНАМИЧЕСКОЕ МЕНЮ ============ -->
                <% if(typeof nav == 'object' && nav && nav.length > 0) { 
                    nav.forEach(function(item) { %>
                        <li class="nav-item">
                            <a class="nav-link" href="/gifts/<%= item.nick %>"><%= item.title %></a>
                        </li>
                    <% });
                } %>
                <!-- ========================================= -->
                
            </ul>
            
            <!-- ============ ПРАВАЯ ЧАСТЬ НАВИГАЦИИ ============ -->
            <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                <% if(user) { %>
                    <!-- ДЛЯ ЗАЛОГИНЕННОГО пользователя: Выйти -->
                    <li class="nav-item">
                        <form action="/logout" method="post" class="d-inline">
                            <button type="submit" class="nav-link btn btn-link" 
                                    style="border: none; background: none; cursor: pointer;">
                                Выйти (<%= user.username %>)
                            </button>
                        </form>
                    </li>
                <% } else { %>
                    <!-- ДЛЯ НЕЗАЛОГИНЕННОГО пользователя: Войти -->
                    <li class="nav-item">
                        <a class="nav-link" href="/logreg">Войти</a>
                    </li>
                <% } %>
            </ul>
            <!-- ======================================================== -->
            
        </div>
    </div>
</nav>
    
    <div class="container container-main">
        <div class="page-header">
            <h1><%= collection.title %></h1>
            <% if (collection.subtitle) { %>
                <p class="text-muted"><%= collection.subtitle %></p>
            <% } %>
        </div>
        
        <!-- Список моделей в 2 столбца -->
        <div class="models-grid">
            <% models.forEach(function(model) { %>
            <a href="/gifts/<%= collection.nick %>/<%= model.id %>" class="model-item">
                <div class="model-name"><%= model.name %></div>
                <div class="model-info">
                    <span class="info-label">Редкость:</span>
                    <span class="info-value"><%= model.rarity %></span>
                </div>
                <div class="model-info">
                    <span class="info-label">Количество:</span>
                    <span class="info-value"><%= model.stock %> шт.</span>
                </div>
            </a>
            <% }); %>
        </div>
    </div>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>